---
/* Anuncio horizontal entre secciones: foto, negocio, una línea de oferta y su botón. */
import type { Ad } from '../data/ads';
import { url } from '../lib/url';
import { smallSrc } from '../lib/img';
import Icon from './Icon.astro';

interface Props {
  ad: Ad;
}
const { ad } = Astro.props;
---

<aside class="adb glass-lite" data-ad={ad.id} aria-label={`Anuncio de ${ad.advertiser}`}>
  <img class="adb__img" src={url(smallSrc(ad.image))} alt="" width="120" height="120" loading="lazy" decoding="async" />
  <div class="adb__body">
    <p class="adb__meta">
      <span class="adb__badge">Patrocinado</span>
      <span>{ad.advertiser} · {ad.town}</span>
    </p>
    <p class="adb__title">
      <a href={url(`/anunciate?desde=${ad.id}`)}>{ad.headline}</a>
    </p>
    <p class="adb__text">{ad.text}</p>
    <p class="adb__note">Anuncio de ejemplo</p>
  </div>
  <span class="adb__cta" aria-hidden="true">{ad.cta} <Icon name="arrowRight" size={16} stroke={2.2} /></span>
  <button type="button" class="adb__hide" data-ad-hide aria-label={`Ocultar el anuncio de ${ad.advertiser}`}>
    <Icon name="x" size={16} stroke={2.2} />
  </button>
</aside>

<style>
  .adb {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-block: 28px;
    padding: 10px 44px 10px 10px;
    border-radius: 26px;
  }

  .adb__img {
    flex: none;
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 18px;
  }

  .adb__body {
    flex: 1;
    min-width: 0;
  }

  .adb__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--tinta-3);
  }

  .adb__badge {
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--tinta);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(74, 56, 22, 0.12);
    font-weight: 800;
    font-size: 0.68rem;
  }

  .adb__title {
    margin: 4px 0 2px;
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .adb__title a {
    color: var(--tinta);
    text-decoration: none;
  }

  /* todo el banner es clickeable (menos el botón de ocultar) */
  .adb__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .adb__text {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--tinta-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .adb__note {
    margin: 2px 0 0;
    font-size: 0.7rem;
    color: var(--tinta-3);
  }

  .adb__cta {
    display: none;
  }

  .adb__hide {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(74, 56, 22, 0.1);
    border-radius: 50%;
    color: var(--tinta-2);
    background: rgba(255, 255, 255, 0.7);
  }

  @media (min-width: 720px) {
    .adb {
      gap: 20px;
      padding-right: 56px;
    }

    .adb__img {
      width: 120px;
      height: 120px;
    }

    .adb__cta {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 6px;
      padding: 10px 16px;
      border-radius: 999px;
      font-weight: 800;
      font-size: 0.9rem;
      color: var(--blanco);
      background: var(--azul-700);
    }
  }
</style>

---
import { url } from '../lib/url';
import { categories } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<nav class="cats" aria-label="Categorías">
  <ul class="cats__list">
    {
      categories.map((c) => (
        <li>
          <a
            href={url(`/categoria/${c.slug}`)}
            class:list={['cat', { 'is-active': active === c.slug }]}
            aria-current={active === c.slug ? 'page' : undefined}
            title={c.name}
          >
            <span class={`cat__circle cat__circle--${c.color}`} aria-hidden="true">
              <Icon name={c.icon} size={30} stroke={1.6} />
            </span>
            <span class="cat__name">{c.short}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .cats {
    max-width: var(--max);
    margin-inline: auto;
  }

  .cats__list {
    list-style: none;
    margin: 0;
    padding: 18px var(--gutter) 8px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 10px) / 4.3);
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .cats__list::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 720px) {
    .cats__list {
      grid-auto-columns: 1fr;
      overflow: visible;
    }
  }

  .cat {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--tinta);
    scroll-snap-align: start;
  }

  .cat__circle {
    position: relative;
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.45));
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: inset 0 1px 0 #fff, inset 0 -3px 8px rgba(255, 255, 255, 0.4), 0 10px 20px -10px rgba(74, 56, 22, 0.45);
    transition: transform 0.3s var(--ease-spring);
  }

  /* tonos oscuros de la paleta: el ícono llega a 3:1 o más sobre el vidrio blanco */
  .cat__circle--azul {
    color: var(--azul-700);
  }

  .cat__circle--rojito {
    color: var(--rojito-700);
  }

  .cat__circle--amarillo {
    color: var(--amarillo-700);
  }

  .cat__circle--verde {
    color: var(--verde-700);
  }

  .cat__circle :global(.icon) {
    filter: drop-shadow(0 2px 2px rgba(74, 56, 22, 0.12));
  }

  .cat:hover .cat__circle {
    transform: translateY(-4px) scale(1.05);
  }

  /* la "rayita" blanca del diseño */
  .cat__name {
    position: relative;
    padding-bottom: 9px;
    font-size: 0.76rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.15;
  }

  .cat__name::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 56px;
    max-width: 100%;
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 1px 3px rgba(74, 56, 22, 0.15);
    transform: translateX(-50%);
  }

  .cat.is-active .cat__circle {
    box-shadow: 0 0 0 3px var(--azul), 0 10px 20px -10px rgba(74, 56, 22, 0.45);
  }

  .cat.is-active .cat__name::after {
    background: var(--azul);
  }
</style>

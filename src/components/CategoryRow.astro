---
import { url } from '../lib/url';
import { categories } from '../data/categories';

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<nav class="cats" aria-label="Categorías">
  <ul class="cats__list">
    {
      categories.map((c) => (
        <li>
          <a
            href={url(`/categoria/${c.slug}`)}
            class:list={['cat', { 'is-active': active === c.slug }]}
            aria-current={active === c.slug ? 'page' : undefined}
          >
            <span class="cat__circle" aria-hidden="true">{c.emoji}</span>
            <span class="cat__name">{c.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .cats {
    max-width: var(--max);
    margin-inline: auto;
  }

  .cats__list {
    list-style: none;
    margin: 0;
    padding: 18px var(--gutter) 6px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 10px) / 4.3);
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .cats__list::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 720px) {
    .cats__list {
      grid-auto-columns: 1fr;
      overflow: visible;
    }
  }

  .cat {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--tinta);
    scroll-snap-align: start;
  }

  .cat__circle {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--blanco);
    font-size: 1.8rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .cat:hover .cat__circle {
    transform: translateY(-3px) rotate(-6deg);
  }

  /* la "rayita" blanca del diseño */
  .cat__name {
    position: relative;
    padding-bottom: 8px;
    font-size: 0.78rem;
    font-weight: 800;
    text-align: center;
    line-height: 1.15;
  }

  .cat__name::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 64px;
    max-width: 100%;
    height: 4px;
    border-radius: 4px;
    background: var(--blanco);
    transform: translateX(-50%);
  }

  .cat.is-active .cat__circle {
    box-shadow: 0 0 0 3px var(--azul);
  }

  .cat.is-active .cat__name::after {
    background: var(--azul);
  }
</style>

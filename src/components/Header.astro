---
import { url } from '../lib/url';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { categories } from '../data/categories';

// Marca el enlace de la página actual en el menú
const here = Astro.url.pathname.replace(/\/$/, '');
const current = (href: string) => (href.split('?')[0].replace(/\/$/, '') === here ? 'page' : undefined);

const community = [
  { href: url('/sobre'), icon: 'info', label: 'Sobre Plaza 787' },
  { href: url('/terminos'), icon: 'shield', label: 'Términos y privacidad' },
  { href: url('/contacto'), icon: 'mail', label: 'Contáctanos' },
] as const;

const mine = [
  { href: url('/cuenta?tab=info'), icon: 'user', label: 'Mi cuenta' },
  { href: url('/favoritos'), icon: 'heart', label: 'Favoritos' },
  { href: url('/mensajes'), icon: 'cart', label: 'Mis compras' },
  { href: url('/cuenta'), icon: 'tag', label: 'Mis publicaciones' },
] as const;
---

<header class="header" data-header>
  <div class="header__inner container">
    <button class="icon-btn glass-strong" type="button" data-menu-open aria-label="Abrir menú" aria-controls="menu">
      <Icon name="menu" size={28} stroke={2.2} />
    </button>

    <Logo />

    <a href={url('/favoritos')} class="icon-btn glass-strong cart" aria-label="Favoritos" title="Favoritos">
      <Icon name="heart" size={28} stroke={1.9} />
      <span class="cart__badge" data-saved-count hidden aria-hidden="true">0</span>
      <span class="sr-only" data-saved-count-sr>sin favoritos</span>
    </a>
  </div>
</header>

<dialog id="menu" class="drawer" aria-labelledby="menu-title">
  <div class="drawer__head">
    <p class="drawer__title" id="menu-title">Tu Plaza</p>
    <button type="button" class="drawer__close" data-menu-close aria-label="Cerrar menú">
      <Icon name="xCircle" size={40} stroke={1.7} />
    </button>
  </div>

  <nav class="drawer__body" aria-label="Menú principal">
    <h2 class="drawer__label">Comunidad y ayuda</h2>
    <ul class="drawer__list drawer__list--icons">
      {
        community.map((l) => (
          <li>
            <a href={l.href} aria-current={current(l.href)}>
              <Icon name={l.icon} size={26} stroke={1.8} />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="drawer__label">Mi Plaza</h2>
    <ul class="drawer__list drawer__list--icons">
      {
        mine.map((l) => (
          <li>
            <a href={l.href}>
              <Icon name={l.icon} size={26} stroke={1.8} />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="drawer__label">Categorías</h2>
    <ul class="drawer__list drawer__list--icons drawer__list--tight">
      {
        categories.map((c) => {
          const href = url(`/categoria/${c.slug}`);
          return (
            <li>
              <a href={href} aria-current={current(href)}>
                <Icon name={c.icon} size={24} stroke={1.8} />
                {c.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</dialog>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-top: env(safe-area-inset-top);
    transition: background-color 0.25s ease, box-shadow 0.25s ease, backdrop-filter 0.25s ease;
  }

  /* al hacer scroll la barra se vuelve vidrio */
  .header.is-scrolled {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.38));
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.7), 0 8px 24px -14px rgba(74, 56, 22, 0.4);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 10px 8px;
  }

  .icon-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border-radius: 50%;
    color: var(--tinta);
    transition: transform 0.2s var(--ease-spring);
  }

  .icon-btn:hover {
    transform: scale(1.06);
  }

  .icon-btn:active {
    transform: scale(0.94);
  }

  .cart__badge {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    background: linear-gradient(180deg, #ff6c61, var(--rojito));
    color: var(--blanco);
    font-weight: 800;
    font-size: 0.75rem;
    line-height: 1;
    box-shadow: 0 4px 10px -2px rgba(246, 78, 67, 0.6);
  }

  .cart__badge.bump {
    animation: bump 0.45s var(--ease-spring);
  }

  @keyframes bump {
    40% {
      transform: scale(1.4);
    }
  }

  /* ---------- Menú lateral "Tu Plaza" ---------- */
  .drawer {
    --drawer-bg: #f2e3c6;
    --drawer-head: #0c8aa6;
    --drawer-label: #08657a;
    position: fixed;
    inset: 0 auto 0 0;
    margin: 0;
    width: min(360px, 86vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0 0 calc(28px + env(safe-area-inset-bottom));
    border: 0;
    color: var(--tinta);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--drawer-bg);
    box-shadow: 18px 0 50px -12px rgba(28, 26, 22, 0.45);
  }

  .drawer[open] {
    animation: slide-in 0.32s var(--ease-spring);
  }

  .drawer::backdrop {
    background: rgba(28, 26, 22, 0.4);
  }

  @keyframes slide-in {
    from {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer[open] {
      animation: none;
    }
  }

  .drawer__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: calc(20px + env(safe-area-inset-top)) 18px 20px 26px;
    background: var(--drawer-head);
    color: var(--blanco);
  }

  .drawer__title {
    margin: 0;
    font-size: clamp(2.1rem, 10vw, 2.7rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .drawer__close {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    transition: transform 0.2s var(--ease-spring), background-color 0.2s ease;
  }

  .drawer__close:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .drawer__close:active {
    transform: scale(0.92);
  }

  .drawer__body {
    padding: 8px 0 0;
  }

  .drawer__label {
    margin: 22px 26px 6px;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--drawer-label);
  }

  .drawer__list {
    list-style: none;
    margin: 0;
    padding: 0 12px;
  }

  .drawer__list a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    /* sin ícono, el texto se alinea con el de las filas que sí tienen (12 + 26 + 12) */
    padding: 8px 14px 8px 50px;
    border-radius: 12px;
    color: var(--tinta);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
  }

  .drawer__list--icons a {
    padding-left: 12px;
  }

  .drawer__list--icons a :global(.icon) {
    flex: none;
    color: var(--verde);
  }

  .drawer__list--tight a {
    min-height: 40px;
    padding-block: 6px;
  }

  /* los íconos de 24px quedan centrados en la misma columna que los de 26px */
  .drawer__list--tight a :global(.icon) {
    margin-inline: 1px;
  }

  .drawer__list a:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  .drawer__list a[aria-current='page'] {
    color: var(--drawer-label);
    background: rgba(255, 255, 255, 0.7);
  }
</style>

<script>
  const menu = document.getElementById('menu') as HTMLDialogElement | null;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu?.showModal());
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  // Cerrar al tocar fuera del panel
  menu?.addEventListener('click', (e) => {
    if (e.target === menu && e.clientX > menu.getBoundingClientRect().right) menu.close();
  });

  // Barra de vidrio al hacer scroll
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 6);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

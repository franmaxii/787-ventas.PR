---
import { site } from '../data/site';
import Icon from './Icon.astro';
import { url } from '../lib/url';
---

<section class="hero" aria-label="Video de Plaza 787">
  {
    site.heroVideo && (
      <video
        class="hero__video"
        src={url(site.heroVideo)}
        poster={site.heroPoster ? url(site.heroPoster) : undefined}
        preload="metadata"
        playsinline
      />
    )
  }
  <div class="hero__overlay" data-hero-overlay>
    <p class="hero__kicker">{site.tagline}</p>
    <button type="button" class="hero__play" data-hero-play data-has-video={site.heroVideo ? 'true' : 'false'} aria-label="Reproducir video">
      <Icon name="play" size={46} />
    </button>
    <p class="hero__note" data-hero-note hidden>🎬 ¡Nuestro video viene pronto!</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    aspect-ratio: 16 / 7.5;
    max-height: 440px;
    background: var(--video);
    border-block: 2px solid rgba(255, 255, 255, 0.85);
    overflow: hidden;
  }

  @media (min-width: 1180px) {
    .hero {
      border: 2px solid rgba(255, 255, 255, 0.85);
      border-radius: var(--radius-lg);
    }
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    background:
      radial-gradient(circle at 15% 20%, rgba(246, 78, 67, 0.25), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(13, 144, 171, 0.3), transparent 45%),
      radial-gradient(circle at 80% 15%, rgba(235, 181, 73, 0.2), transparent 35%);
    transition: opacity 0.25s ease;
  }

  .hero__overlay.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hero__kicker {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 800;
    font-size: clamp(0.8rem, 3vw, 1rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__play {
    display: grid;
    place-items: center;
    width: clamp(64px, 20vw, 92px);
    aspect-ratio: 1;
    padding: 0 0 0 6px;
    border: 0;
    border-radius: 50%;
    background: var(--blanco);
    color: #111;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease;
  }

  .hero__play :global(.icon) {
    width: 50%;
    height: 50%;
  }

  .hero__play:hover {
    transform: scale(1.07);
  }

  .hero__note {
    margin: 0;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--amarillo);
    color: var(--tinta);
    font-weight: 800;
    font-size: 0.9rem;
  }
</style>

<script>
  const play = document.querySelector<HTMLButtonElement>('[data-hero-play]');
  const overlay = document.querySelector<HTMLElement>('[data-hero-overlay]');
  const note = document.querySelector<HTMLElement>('[data-hero-note]');
  const video = document.querySelector<HTMLVideoElement>('.hero__video');

  play?.addEventListener('click', async () => {
    if (!video) {
      if (note) note.hidden = false;
      return;
    }
    try {
      video.controls = true;
      await video.play();
      overlay?.classList.add('is-hidden');
    } catch {
      if (note) note.hidden = false;
    }
  });

  video?.addEventListener('ended', () => {
    video.controls = false;
    overlay?.classList.remove('is-hidden');
  });
</script>

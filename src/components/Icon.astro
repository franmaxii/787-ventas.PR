---
/*
 * Íconos de Heroicons (Tailwind Labs, MIT): https://heroicons.com
 * Se leen del paquete `heroicons` en tiempo de build; no se envía JS al navegador.
 */
const outline = import.meta.glob<string>('/node_modules/heroicons/24/outline/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const solid = import.meta.glob<string>('/node_modules/heroicons/24/solid/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

/** Nombre corto usado en el proyecto → nombre del archivo en Heroicons. */
const names = {
  menu: 'list-bullet',
  cart: 'shopping-cart',
  search: 'magnifying-glass',
  x: 'x-mark',
  play: 'play',
  camera: 'camera',
  chat: 'chat-bubble-oval-left',
  user: 'user',
  users: 'users',
  heart: 'heart',
  bag: 'shopping-bag',
  home: 'home',
  key: 'key',
  truck: 'truck',
  shield: 'shield-check',
  pin: 'map-pin',
  plus: 'plus',
  minus: 'minus',
  trash: 'trash',
  chevronRight: 'chevron-right',
  chevronLeft: 'chevron-left',
  check: 'check',
  checkCircle: 'check-circle',
  star: 'star',
  filter: 'adjustments-horizontal',
  store: 'building-storefront',
  bell: 'bell',
  tag: 'tag',
  send: 'paper-airplane',
  help: 'question-mark-circle',
  image: 'photo',
  card: 'credit-card',
  cash: 'banknotes',
  box: 'cube',
  pencil: 'pencil',
  cog: 'cog-6-tooth',
  lock: 'lock-closed',
  eye: 'eye',
  eyeOff: 'eye-slash',
  id: 'identification',
  verified: 'check-badge',
  sparkles: 'sparkles',
  fire: 'fire',
  clock: 'clock',
  refresh: 'arrow-path',
  archive: 'archive-box',
  phone: 'device-phone-mobile',
  mail: 'envelope',
  cake: 'cake',
  logout: 'arrow-right-on-rectangle',
  userPlus: 'user-plus',
  arrowLeft: 'arrow-left',
  arrowRight: 'arrow-right',
  grid: 'squares-2x2',
  bolt: 'bolt',
  bookmark: 'bookmark',
  gift: 'gift',
  share: 'share',
  flag: 'flag',
  map: 'map',
  currency: 'currency-dollar',
  shieldAlert: 'shield-exclamation',
  calendar: 'calendar-days',
  gauge: 'chart-bar',
  info: 'information-circle',
  xCircle: 'x-circle',
  document: 'document-text',
  homeModern: 'home-modern',
  faceSmile: 'face-smile',
  sun: 'sun',
  inboxStack: 'inbox-stack',
  folderPlus: 'folder-plus',
  more: 'ellipsis-horizontal',
  stack: 'rectangle-stack',
} as const;

export type IconName = keyof typeof names;

interface Props {
  name: IconName;
  /** Variante rellena de Heroicons. */
  solid?: boolean;
  size?: number | string;
  /** Grosor del trazo (solo variante outline). */
  stroke?: number;
  class?: string;
  label?: string;
}

const { name, solid: isSolid = false, size = 24, stroke = 1.7, class: className, label } = Astro.props;
const set = isSolid ? solid : outline;
const raw = set[`/node_modules/heroicons/24/${isSolid ? 'solid' : 'outline'}/${names[name]}.svg`];
if (!raw) throw new Error(`Ícono no encontrado: ${name}`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={isSolid ? 'currentColor' : 'none'}
  stroke={isSolid ? undefined : 'currentColor'}
  stroke-width={isSolid ? undefined : stroke}
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>

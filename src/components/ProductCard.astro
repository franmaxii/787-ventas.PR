---
import { url } from '../lib/url';
import type { Product } from '../data/products';
import { getSeller } from '../data/products';
import { discountPct, formatMoney, shippingText } from '../lib/format';
import Icon from './Icon.astro';
import ProductImage from './ProductImage.astro';

interface Props {
  product: Product;
  /** Atributos de datos para filtrar en el cliente (búsqueda). */
  filterable?: boolean;
}
const { product: p, filterable = false } = Astro.props;
const off = discountPct(p.price, p.originalPrice);
const seller = getSeller(p.sellerId);

const data = filterable
  ? {
      'data-id': p.id,
      'data-title': `${p.title} ${p.description} ${p.details.join(' ')}`.toLowerCase(),
      'data-category': p.category,
      'data-price': String(p.price),
      'data-condition': p.condition,
      'data-free': String(p.shipping === 0),
      'data-off': String(off),
      'data-town': seller?.town ?? '',
      'data-sold': String(p.sold),
    }
  : {};
---

<article class="card glass-lite" {...data}>
  <div class="card__media">
    <ProductImage product={p} />
    {off > 0 && <span class="card__badge">-{off}%</span>}
  </div>
  <!-- fuera de .card__media: su transform en hover dejaría el botón debajo del enlace -->
  <button
    type="button"
    class="card__fav"
    data-fav={p.id}
    aria-pressed="false"
    aria-label={`Guardar ${p.title} en favoritos`}
  >
    <Icon name="heart" size={20} stroke={2} />
  </button>

  <div class="card__body">
    <h3 class="card__title">
      <a href={url(`/producto/${p.id}`)}>{p.title}</a>
    </h3>

    <p class="card__price">
      <strong>{formatMoney(p.price)}</strong>
      {p.originalPrice && off > 0 && <s>{formatMoney(p.originalPrice)}</s>}
    </p>
    <p class:list={['card__ship', { free: p.shipping === 0 }]}>
      {p.shipping === 0 && <Icon name="truck" size={15} stroke={2} />}
      {shippingText(p.shipping)}
    </p>
    <p class="card__desc">{p.description}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 8px;
    border-radius: 28px;
    text-align: center;
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--glass-edge), 0 22px 40px -16px rgba(74, 56, 22, 0.4);
  }

  .card:hover :global(.pimg img) {
    transform: scale(1.07) rotate(-2deg);
  }

  .card__media {
    position: relative;
  }

  .card__badge {
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 2;
    padding: 3px 9px;
    border-radius: 999px;
    color: var(--blanco);
    font-weight: 800;
    font-size: 0.75rem;
    background: linear-gradient(180deg, #4fae69, var(--verde));
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 4px 10px -4px rgba(57, 149, 82, 0.8);
  }

  .card__fav {
    position: absolute;
    right: 16px;
    top: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    color: var(--rojito);
    background: rgba(255, 255, 255, 0.75);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s var(--ease-spring);
  }

  .card__fav:active {
    transform: scale(0.85);
  }

  .card__fav[aria-pressed='true'] :global(.icon) {
    fill: currentColor;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 6px 8px;
  }

  .card__title {
    font-size: clamp(0.98rem, 3.5vw, 1.1rem);
    font-weight: 800;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__title a {
    color: var(--tinta);
    text-decoration: none;
  }

  /* toda la tarjeta es clickeable */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .card__price {
    margin: 2px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 6px;
  }

  .card__price strong {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .card__price s {
    color: var(--tinta-3);
    font-size: 0.82rem;
  }

  .card__ship {
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tinta-2);
  }

  .card__ship.free {
    color: var(--verde-700);
  }

  .card__desc {
    margin: 2px 0 0;
    font-size: 0.85rem;
    color: var(--tinta-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

---
import type { Product } from '../data/products';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  filterable?: boolean;
  id?: string;
  /** Fila con scroll horizontal en vez de cuadrícula. */
  scroller?: boolean;
}
const { products, filterable = false, id, scroller = false } = Astro.props;
---

<div class:list={['grid', { 'grid--scroller': scroller }]} id={id}>
  {products.map((p) => <ProductCard product={p} filterable={filterable} />)}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 18px;
    }
  }

  .grid--scroller {
    display: grid;
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(160px, 42%);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-block: 6px 18px;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  .grid--scroller > :global(*) {
    scroll-snap-align: start;
  }

  @media (min-width: 720px) {
    .grid--scroller {
      grid-auto-columns: 210px;
    }
  }
</style>

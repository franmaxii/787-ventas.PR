---
import type { Product } from '../data/products';
import ProductCard from './ProductCard.astro';
import AdCard from './AdCard.astro';
import type { Ad } from '../data/ads';

interface Props {
  products: Product[];
  filterable?: boolean;
  id?: string;
  /** Fila con scroll horizontal en vez de cuadrícula. */
  scroller?: boolean;
  /** Botón de colección en cada tarjeta. */
  collect?: boolean;
  /** Anuncio nativo dentro de la cuadrícula (uno como máximo). */
  ad?: Ad;
  /** Cuántas publicaciones van antes del anuncio. */
  adSlot?: number;
}
const { products, filterable = false, id, scroller = false, collect = false, ad, adSlot = 4 } = Astro.props;
const slot = Math.min(adSlot, products.length);
---

<div class:list={['grid', { 'grid--scroller': scroller }]} id={id}>
  {
    products.map((p, i) => (
      <Fragment>
        {ad && i === slot && <AdCard ad={ad} after={adSlot} />}
        <ProductCard product={p} filterable={filterable} collect={collect} />
      </Fragment>
    ))
  }
  {ad && slot === products.length && products.length > 0 && <AdCard ad={ad} after={adSlot} />}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 18px;
    }
  }

  .grid--scroller {
    display: grid;
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(160px, 42%);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-block: 6px 18px;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  .grid--scroller > :global(*) {
    scroll-snap-align: start;
  }

  @media (min-width: 720px) {
    .grid--scroller {
      grid-auto-columns: 210px;
    }
  }
</style>

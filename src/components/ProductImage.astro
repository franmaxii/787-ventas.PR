---
import type { Product } from '../data/products';
import { url } from '../lib/url';
import { smallSrc } from '../lib/img';

interface Props {
  product: Pick<Product, 'title' | 'emoji' | 'color' | 'image'>;
  size?: 'card' | 'large' | 'thumb';
  loading?: 'lazy' | 'eager';
}
const { product, size = 'card', loading = 'lazy' } = Astro.props;
// Las ilustraciones SVG se muestran completas; una foto real llena el cuadro.
const isPhoto = !!product.image && !product.image.endsWith('.svg');
const small = product.image ? smallSrc(product.image) : '';
const hasSmall = isPhoto && small !== product.image;
const sizes = { card: '(min-width: 720px) 220px, 46vw', large: '(min-width: 900px) 560px, 92vw', thumb: '96px' }[size];
---

<div class:list={['pimg', `pimg--${size}`, 'tile', `tile--${product.color}`]}>
  {
    product.image ? (
      <img
        src={url(size === 'large' ? product.image : small)}
        srcset={hasSmall ? `${url(small)} 400w, ${url(product.image)} 800w` : undefined}
        sizes={hasSmall ? sizes : undefined}
        alt={size === 'large' ? product.title : ''}
        class:list={{ 'is-photo': isPhoto }}
        loading={loading}
        decoding="async"
        width="240"
        height="240"
      />
    ) : (
      <span class="pimg__emoji" aria-hidden="true">
        {product.emoji}
      </span>
    )
  }
</div>

<style>
  .pimg {
    aspect-ratio: 1;
    width: 100%;
    border-radius: 22px;
  }

  .pimg--large {
    border-radius: var(--radius-xl);
  }

  .pimg--thumb {
    border-radius: 14px;
  }

  .pimg img {
    position: relative;
    z-index: 0;
    transition: transform 0.35s var(--ease-spring);
  }

  .pimg--large img:not(.is-photo) {
    padding: 10%;
  }

  .pimg__emoji {
    font-size: clamp(3rem, 16vw, 5rem);
    line-height: 1;
  }
</style>

---
import { url } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  value?: string;
  autofocus?: boolean;
  /** id del input (para tener más de un buscador en la misma página). */
  id?: string;
  placeholder?: string;
  /** Si es false, no navega a /buscar: solo emite eventos de input (filtros locales). */
  action?: boolean;
}
const {
  value = '',
  autofocus = false,
  id = 'q',
  placeholder = 'Buscar en Plaza 787…',
  action = true,
} = Astro.props;
---

<div class="search-wrap">
  <form
    class="search glass"
    action={action ? url('/buscar') : undefined}
    method="get"
    role="search"
    data-search-form
    data-local={action ? undefined : ''}
  >
    <label for={id} class="sr-only">Buscar productos</label>
    <span class="search__icon"><Icon name="search" size={24} stroke={2} /></span>
    <input
      id={id}
      class="search__input"
      type="search"
      name="q"
      value={value}
      placeholder={placeholder}
      autocomplete="off"
      enterkeyhint="search"
      autofocus={autofocus}
    />
    <button type="button" class="search__clear" data-search-clear aria-label="Borrar búsqueda">
      <Icon name="x" size={16} stroke={2.6} />
    </button>
  </form>
</div>

<style>
  .search-wrap {
    max-width: var(--max);
    margin-inline: auto;
    padding: 14px var(--gutter) 2px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px 6px 16px;
    border-radius: 999px;
    transition: box-shadow 0.2s ease;
  }

  .search:focus-within {
    box-shadow: 0 0 0 4px rgba(13, 144, 171, 0.2), var(--glass-edge), var(--glass-shadow);
  }

  .search__icon {
    display: grid;
    color: var(--tinta-3);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    font-size: 1.02rem;
    font-weight: 500;
  }

  .search__input::placeholder {
    color: var(--tinta-3);
    font-weight: 400;
  }

  .search__input:focus {
    outline: none;
  }

  /* ocultamos la X nativa del navegador */
  .search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .search__clear {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: rgba(61, 61, 61, 0.85);
    color: var(--blanco);
    transition: opacity 0.15s ease, transform 0.2s var(--ease-spring);
  }

  .search__input:placeholder-shown ~ .search__clear {
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-search-form]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]');
    form.querySelector('[data-search-clear]')?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
    });
    // buscadores locales (p. ej. en el perfil) no navegan
    if (form.hasAttribute('data-local')) form.addEventListener('submit', (e) => e.preventDefault());
  });
</script>

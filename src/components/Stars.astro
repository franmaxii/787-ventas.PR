---
import Icon from './Icon.astro';

interface Props {
  rating: number;
  size?: number;
}
const { rating, size = 16 } = Astro.props;
const pct = Math.max(0, Math.min(100, (rating / 5) * 100));
---

<span class="stars" role="img" aria-label={`${rating.toFixed(1)} de 5 estrellas`} style={`--pct:${pct}%`}>
  <span class="stars__base" aria-hidden="true">
    {Array.from({ length: 5 }, () => <Icon name="star" size={size} />)}
  </span>
  <span class="stars__fill" aria-hidden="true">
    {Array.from({ length: 5 }, () => <Icon name="star" size={size} />)}
  </span>
</span>

<style>
  .stars {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
  }

  .stars__base,
  .stars__fill {
    display: inline-flex;
    gap: 1px;
  }

  .stars__base {
    color: rgba(29, 27, 23, 0.18);
  }

  .stars__fill {
    position: absolute;
    inset: 0;
    color: var(--amarillo);
    clip-path: inset(0 calc(100% - var(--pct)) 0 0);
  }
</style>

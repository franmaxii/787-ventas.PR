---
import { url } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Color de acento de la sección (el perfil usa rojito, como en el diseño). */
  accent?: 'verde' | 'rojito' | 'azul';
}
const { title, description = site.description, accent = 'verde' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
---

<!doctype html>
<html lang="es-PR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eedbba" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&family=Chewy&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body style={`--accent: var(--${accent})`}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <BottomNav />
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--azul);
    color: var(--blanco);
    font-weight: 700;
  }

  .skip:focus {
    top: 12px;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(var(--bottom-nav-h) + 24px + env(safe-area-inset-bottom));
    z-index: 60;
    max-width: calc(100% - 32px);
    padding: 12px 20px;
    border-radius: 999px;
    color: var(--blanco);
    font-weight: 600;
    font-size: 0.95rem;
    background: rgba(28, 26, 22, 0.78);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 12px 30px -8px rgba(0, 0, 0, 0.45);
    transform: translate(-50%, 16px) scale(0.96);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.25s var(--ease-spring);
  }

  .toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
</style>

<script>
  import '../scripts/app';
</script>

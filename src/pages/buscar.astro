---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Icon from '../components/Icon.astro';
import LocationChip from '../components/LocationChip.astro';
import { activeProducts as products } from '../data/products';
import { categories } from '../data/categories';
---

<Layout title="Buscar" description="Busca publicaciones cerca de ti en Plaza 787.">
  <SearchBar />
  <LocationChip />

  <div class="container">
    <div class="results-head">
      <div>
        <h1 class="page-title" data-results-title>Todas las publicaciones</h1>
        <p class="page-sub" data-results-count>{products.length} resultados</p>
      </div>
    </div>

    <form class="filters" data-filters>
      <div class="filters__bar">
        <button type="button" class="chip" aria-expanded="false" aria-controls="filters-panel" data-filters-toggle>
          <Icon name="filter" size={18} /> Filtros
        </button>

        <label class="chip chip--toggle">
          <input type="checkbox" name="gratis" value="1" />
          <Icon name="gift" size={18} /> Gratis
        </label>
        <label class="chip chip--toggle">
          <input type="checkbox" name="baja" value="1" />
          <Icon name="tag" size={18} /> Bajó de precio
        </label>

        <label class="sort">
          <span class="sr-only">Ordenar por</span>
          <select name="orden" class="select">
            <option value="">Sugeridos</option>
            <option value="cerca">Más cerca</option>
            <option value="recientes">Más recientes</option>
            <option value="menor">Menor precio</option>
            <option value="mayor">Mayor precio</option>
          </select>
        </label>
      </div>
      <div class="filters__panel panel" id="filters-panel" hidden>
        <div class="filters__grid">
          <div class="field">
            <label for="f-cat">Categoría</label>
            <select id="f-cat" name="categoria" class="select">
              <option value="">Todas</option>
              {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-cond">Condición</label>
            <select id="f-cond" name="condicion" class="select">
              <option value="">Nuevo y usado</option>
              <option value="nuevo">Nuevo</option>
              <option value="usado">Usado</option>
            </select>
          </div>
          <div class="field">
            <label for="f-days">Publicado</label>
            <select id="f-days" name="dias" class="select">
              <option value="">Cuando sea</option>
              <option value="1">Últimas 24 horas</option>
              <option value="7">Últimos 7 días</option>
              <option value="30">Últimos 30 días</option>
            </select>
          </div>
          <fieldset class="field price">
            <legend>Precio (USD)</legend>
            <div class="price__row">
              <input name="min" type="number" min="0" inputmode="numeric" class="input" placeholder="Mínimo" aria-label="Precio mínimo" />
              <span aria-hidden="true">–</span>
              <input name="max" type="number" min="0" inputmode="numeric" class="input" placeholder="Máximo" aria-label="Precio máximo" />
            </div>
          </fieldset>
        </div>
        <button type="reset" class="btn btn--soft">Limpiar filtros</button>
      </div>
    </form>

    <ProductGrid products={products} filterable id="results" />

    <div class="empty" data-results-empty hidden>
      <span class="empty__icon"><Icon name="search" size={40} /></span>
      <h2>No encontramos publicaciones</h2>
      <p>Prueba con otras palabras o amplía la distancia.</p>
      <button type="button" class="btn btn--primary" data-location-open>Cambiar ubicación o distancia</button>
      <a href={url('/buscar')} class="btn btn--soft">Quitar filtros</a>
    </div>
  </div>
</Layout>

<style>
  .results-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
  }

  .filters {
    margin-bottom: 22px;
  }

  .filters__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  [data-filters-toggle][aria-expanded='true'] {
    border-color: var(--azul);
    background: var(--azul-100);
    color: var(--azul-700);
  }

  .filters__panel {
    margin-top: 12px;
  }

  .filters__grid {
    display: grid;
    gap: 0 16px;
  }

  @media (min-width: 720px) {
    .filters__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .price {
    border: 0;
    padding: 0;
    margin: 0 0 14px;
  }

  .price__row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sort {
    margin-left: auto;
  }

  .sort .select {
    min-height: 40px;
    padding-block: 6px;
    border-radius: 999px;
    font-weight: 700;
  }
</style>

<script>
  import { initFilters } from '../scripts/filter';
  import { categories } from '../data/categories';

  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const title = document.querySelector<HTMLElement>('[data-results-title]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-filters-toggle]')!;
  const panel = document.getElementById('filters-panel')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  });

  form.addEventListener('filters:applied', (e) => {
    const s = (e as CustomEvent).detail as { q: string; categoria: string; gratis: boolean };
    const cat = categories.find((c) => c.slug === s.categoria);
    title.textContent = s.q
      ? `“${s.q}”`
      : s.gratis
        ? 'Gratis'
        : cat
          ? cat.name
          : 'Todas las publicaciones';
    document.title = `${title.textContent} | Plaza 787`;
  });

  initFilters({
    form,
    grid: document.getElementById('results')!,
    queryInput: document.querySelector<HTMLInputElement>('#q'),
    count: document.querySelector('[data-results-count]'),
    empty: document.querySelector('[data-results-empty]'),
    syncUrl: true,
  });
</script>

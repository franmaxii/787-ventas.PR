---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { municipios } from '../data/site';
---

<Layout title="Carrito">
  <div class="container cart-page">
    <h1 class="page-title">Carrito</h1>

    <div class="cart" data-cart hidden>
      <ul class="cart__lines" data-cart-lines></ul>

      <aside class="summary panel" aria-labelledby="summary-title">
        <h2 id="summary-title">Resumen de compra</h2>
        <dl>
          <div><dt data-sum-label>Productos</dt><dd data-sum-subtotal></dd></div>
          <div><dt>Envío</dt><dd data-sum-shipping></dd></div>
          <div class="total"><dt>Total</dt><dd data-sum-total></dd></div>
        </dl>
        <button type="button" class="btn btn--primary btn--block" data-checkout-open>Continuar compra</button>
      </aside>
    </div>

    <form class="checkout panel" data-checkout hidden>
      <h2>¿Cómo quieres recibirlo?</h2>

      <fieldset class="options">
        <legend class="sr-only">Entrega</legend>
        <label class="option">
          <input type="radio" name="delivery" value="envio" checked />
          <span><strong>Envío a domicilio</strong><small>Llega en 2 a 4 días laborables</small></span>
        </label>
        <label class="option">
          <input type="radio" name="delivery" value="recogido" />
          <span><strong>Recoger con el vendedor</strong><small>Gratis · coordinas por mensaje</small></span>
        </label>
      </fieldset>

      <div class="grid2">
        <div class="field">
          <label for="c-name">Nombre completo</label>
          <input id="c-name" name="name" class="input" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-phone">Teléfono</label>
          <input id="c-phone" name="phone" class="input" type="tel" autocomplete="tel" placeholder="(787) 555-0123" required />
        </div>
        <div class="field" data-address-field>
          <label for="c-address">Dirección</label>
          <input id="c-address" name="address" class="input" autocomplete="street-address" placeholder="Calle, número, urbanización" required />
        </div>
        <div class="field">
          <label for="c-town">Municipio</label>
          <select id="c-town" name="town" class="select" required>
            <option value="">Selecciona…</option>
            {municipios.map((m) => <option value={m}>{m}</option>)}
          </select>
        </div>
      </div>

      <h2>¿Cómo vas a pagar?</h2>
      <fieldset class="options">
        <legend class="sr-only">Método de pago</legend>
        <label class="option">
          <input type="radio" name="payment" value="ATH Móvil" checked />
          <span><strong>ATH Móvil</strong><small>Paga desde tu celular</small></span>
        </label>
        <label class="option">
          <input type="radio" name="payment" value="Tarjeta" />
          <span><strong>Tarjeta de crédito o débito</strong><small>Visa, Mastercard, AmEx</small></span>
        </label>
        <label class="option">
          <input type="radio" name="payment" value="Efectivo" />
          <span><strong>Efectivo al recoger</strong><small>Solo si recoges con el vendedor</small></span>
        </label>
      </fieldset>

      <p class="note"><Icon name="shield" size={18} /> Esto es una demo: no se cobra nada.</p>

      <div class="checkout__actions">
        <button type="button" class="btn btn--soft" data-checkout-back>Volver</button>
        <button type="submit" class="btn btn--green" data-confirm>Confirmar compra</button>
      </div>
    </form>

    <div class="empty" data-cart-empty hidden>
      <div class="empty__emoji">🛒</div>
      <h2>Tu carrito está vacío</h2>
      <p>Suma productos y aprovecha el envío gratis a toda la isla.</p>
      <a href={url('/')} class="btn btn--primary">Descubrir productos</a>
    </div>
  </div>
</Layout>

<style is:global>
  .cart-page .cart {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  @media (min-width: 860px) {
    .cart-page .cart {
      grid-template-columns: 1fr 340px;
    }

    .cart-page .summary {
      position: sticky;
      top: 16px;
    }
  }

  .cart-page .cart__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .cart-page .line {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 14px;
    border-radius: var(--radius-lg);
    background: var(--blanco);
    box-shadow: var(--shadow-sm);
  }

  .cart-page .line__img {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 12px;
    font-size: 2.4rem;
    text-decoration: none;
    overflow: hidden;
  }

  .cart-page .line__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-page .line__title {
    display: block;
    color: var(--tinta);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
  }

  .cart-page .line__ship {
    margin: 4px 0 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--tinta-2);
  }

  .cart-page .line__ship.free {
    color: var(--verde-700);
  }

  .cart-page .line__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .cart-page .stepper {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--linea);
    border-radius: 999px;
  }

  .cart-page .stepper button {
    width: 36px;
    height: 36px;
    border: 0;
    background: none;
    color: var(--azul-700);
    font-size: 1.2rem;
    font-weight: 900;
  }

  .cart-page .stepper button:disabled {
    color: var(--linea);
    cursor: not-allowed;
  }

  .cart-page .stepper output {
    min-width: 28px;
    text-align: center;
    font-weight: 800;
  }

  .cart-page .line__remove {
    border: 0;
    background: none;
    padding: 6px 0;
    color: var(--rojito-700);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .cart-page .line__price {
    font-size: 1.15rem;
    font-weight: 900;
    white-space: nowrap;
  }

  .cart-page .summary h2,
  .cart-page .checkout h2 {
    font-size: 1.25rem;
    margin-bottom: 12px;
  }

  .cart-page .summary dl {
    margin: 0 0 16px;
  }

  .cart-page .summary dl div {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
  }

  .cart-page .summary dd {
    margin: 0;
    font-weight: 700;
  }

  .cart-page .summary .free {
    color: var(--verde-700);
  }

  .cart-page .summary .total {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 2px dashed var(--linea);
    font-size: 1.25rem;
    font-weight: 900;
  }

  .cart-page .checkout {
    max-width: 760px;
  }

  .cart-page .checkout h2:not(:first-child) {
    margin-top: 18px;
  }

  .cart-page .options {
    border: 0;
    padding: 0;
    margin: 0 0 16px;
    display: grid;
    gap: 10px;
  }

  .cart-page .option {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 14px;
    border: 2px solid var(--linea);
    border-radius: 14px;
    cursor: pointer;
  }

  .cart-page .option:has(input:checked) {
    border-color: var(--azul);
    background: var(--azul-100);
  }

  .cart-page .option:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cart-page .option input {
    width: 20px;
    height: 20px;
    accent-color: var(--azul);
  }

  .cart-page .option strong,
  .cart-page .option small {
    display: block;
  }

  .cart-page .option small {
    color: var(--tinta-3);
  }

  .cart-page .grid2 {
    display: grid;
    gap: 0 16px;
  }

  @media (min-width: 720px) {
    .cart-page .grid2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cart-page .note {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--tinta-2);
    font-size: 0.9rem;
  }

  .cart-page .checkout__actions {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>

<script>
  import { products, getProduct } from '../data/products';
  import { formatMoney, shippingText } from '../lib/format';
  import { base, url } from '../lib/url';
  import { cart, onChange, orders, uid } from '../scripts/store';
  import { esc, toast } from '../scripts/ui';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const wrap = $('[data-cart]');
  const list = $('[data-cart-lines]');
  const empty = $('[data-cart-empty]');
  const checkout = $<HTMLFormElement>('[data-checkout]');

  function currentLines() {
    return cart
      .lines()
      .map((l) => ({ ...l, product: getProduct(l.id)! }))
      .filter((l) => l.product);
  }

  function totals(delivery: 'envio' | 'recogido' = 'envio') {
    const lines = currentLines();
    const units = lines.reduce((n, l) => n + l.qty, 0);
    const subtotal = lines.reduce((n, l) => n + l.qty * l.product.price, 0);
    const shipping = delivery === 'recogido' ? 0 : lines.reduce((n, l) => n + l.product.shipping, 0);
    return { lines, units, subtotal, shipping, total: subtotal + shipping };
  }

  let leaving = false;

  function render() {
    if (leaving) return;
    const t = totals();
    const isEmpty = t.lines.length === 0;
    empty.hidden = !isEmpty;
    wrap.hidden = isEmpty || !checkout.hidden;
    if (isEmpty) {
      checkout.hidden = true;
      return;
    }

    list.innerHTML = t.lines
      .map(({ product: p, qty }) => {
        const href = `${base}/producto/${p.id}`;
        const img = p.image ? `<img src="${esc(url(p.image))}" alt="" />` : esc(p.emoji);
        const max = Math.min(p.stock, 99);
        return `
        <li class="line" data-id="${esc(p.id)}">
          <a class="line__img" href="${href}" style="background: var(--${esc(p.color)})" aria-hidden="true" tabindex="-1">${img}</a>
          <div>
            <a class="line__title" href="${href}">${esc(p.title)}</a>
            <p class="line__ship ${p.shipping === 0 ? 'free' : ''}">${shippingText(p.shipping)}</p>
            <div class="line__row">
              <div class="stepper" role="group" aria-label="Cantidad">
                <button type="button" data-dec aria-label="Quitar uno" ${qty <= 1 ? 'disabled' : ''}>−</button>
                <output aria-live="polite">${qty}</output>
                <button type="button" data-inc aria-label="Sumar uno" ${qty >= max ? 'disabled' : ''}>+</button>
              </div>
              <button type="button" class="line__remove" data-remove>Eliminar</button>
            </div>
          </div>
          <strong class="line__price">${formatMoney(p.price * qty)}</strong>
        </li>`;
      })
      .join('');

    $('[data-sum-label]').textContent = `Productos (${t.units})`;
    $('[data-sum-subtotal]').textContent = formatMoney(t.subtotal);
    const ship = $('[data-sum-shipping]');
    ship.textContent = t.shipping === 0 ? 'Gratis' : formatMoney(t.shipping);
    ship.classList.toggle('free', t.shipping === 0);
    $('[data-sum-total]').textContent = formatMoney(t.total);
  }

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    const id = btn?.closest<HTMLElement>('[data-id]')?.dataset.id;
    if (!btn || !id) return;
    const line = cart.lines().find((l) => l.id === id);
    if (!line) return;
    if (btn.hasAttribute('data-inc')) cart.setQty(id, line.qty + 1);
    if (btn.hasAttribute('data-dec')) cart.setQty(id, Math.max(1, line.qty - 1));
    if (btn.hasAttribute('data-remove')) {
      cart.remove(id);
      toast('Producto eliminado');
    }
  });

  // ---------- Checkout ----------
  const confirmBtn = $<HTMLButtonElement>('[data-confirm]');
  const addressField = $('[data-address-field]');
  const cashInput = checkout.querySelector<HTMLInputElement>('input[name="payment"][value="Efectivo"]')!;

  function delivery() {
    return (checkout.elements.namedItem('delivery') as RadioNodeList).value as 'envio' | 'recogido';
  }

  function syncCheckout() {
    const d = delivery();
    const pickup = d === 'recogido';
    addressField.hidden = pickup;
    addressField.querySelector('input')!.required = !pickup;
    cashInput.disabled = !pickup;
    if (!pickup && cashInput.checked) {
      checkout.querySelector<HTMLInputElement>('input[name="payment"][value="ATH Móvil"]')!.checked = true;
    }
    confirmBtn.textContent = `Confirmar compra · ${formatMoney(totals(d).total)}`;
  }

  $('[data-checkout-open]').addEventListener('click', () => {
    wrap.hidden = true;
    checkout.hidden = false;
    syncCheckout();
    checkout.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  $('[data-checkout-back]').addEventListener('click', () => {
    checkout.hidden = true;
    render();
  });

  checkout.addEventListener('change', syncCheckout);

  checkout.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(checkout);
    const d = delivery();
    const t = totals(d);
    if (t.lines.length === 0) return;
    const id = uid().toUpperCase();
    const saved = orders.add({
      id,
      date: new Date().toISOString(),
      lines: t.lines.map(({ product: p, qty }) => ({
        id: p.id,
        title: p.title,
        price: p.price,
        qty,
        emoji: p.emoji,
        color: p.color,
      })),
      subtotal: t.subtotal,
      shipping: t.shipping,
      total: t.total,
      payment: String(data.get('payment')),
      name: String(data.get('name')),
      town: String(data.get('town')),
      delivery: d,
    });
    if (!saved) {
      toast('No se pudo guardar la compra en este navegador');
      return;
    }
    leaving = true;
    cart.clear();
    window.location.href = `${base}/compras?nueva=${encodeURIComponent(id)}`;
  });

  // si cambia el catálogo y algún id del carrito ya no existe, lo limpiamos
  cart.lines().forEach((l) => {
    if (!products.some((p) => p.id === l.id)) cart.remove(l.id);
  });

  render();
  onChange(render);
</script>

---
import Layout from '../../layouts/Layout.astro';
import CategoryRow from '../../components/CategoryRow.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import Icon from '../../components/Icon.astro';
import { categories, SPECIAL_CATEGORIES, type Category } from '../../data/categories';
import { activeProducts as products } from '../../data/products';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const items = products.filter((p) => p.category === category.slug);
---

<Layout title={category.name} description={`${category.name} en Plaza 787. ${category.blurb}`}>
  <div class="container">
    <header class:list={['banner', 'tile', `tile--${category.color}`, { dark: category.color === 'amarillo' }]}>
      <span class="banner__art" aria-hidden="true"><Icon name={category.icon} size={44} stroke={1.5} /></span>
      <div>
        <h1>{category.name}</h1>
        <p>{category.blurb}</p>
      </div>
    </header>
  </div>

  <CategoryRow active={category.slug} />

  <div class="container">
    <form class="bar" data-filters>
      <p class="count" data-results-count>{items.length} resultados</p>
      <button type="button" class="chip" data-location-open><Icon name="pin" solid size={16} /> <span data-location-label>Ubicación</span></button>
      {
        !SPECIAL_CATEGORIES.includes(category.slug) && (
          <label class="chip chip--toggle">
            <input type="checkbox" name="gratis" value="1" />
            <Icon name="gift" size={18} /> Gratis
          </label>
        )
      }
      <label class="sort">
        <span class="sr-only">Ordenar por</span>
        <select name="orden" class="select">
          <option value="">Sugeridos</option>
          <option value="cerca">Más cerca</option>
          <option value="recientes">Más recientes</option>
          <option value="menor">Menor precio</option>
          <option value="mayor">Mayor precio</option>
        </select>
      </label>
    </form>

    <ProductGrid products={items} filterable id="results" />

    <div class="empty" data-results-empty hidden>
      <span class="empty__icon"><Icon name="filter" size={40} /></span>
      <h2>No hay publicaciones con esos filtros</h2>
      <p>Amplía la distancia o quita "Gratis".</p>
      <button type="button" class="btn btn--primary" data-location-open>Cambiar distancia</button>
    </div>
  </div>
</Layout>

<style>
  .banner {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
    padding: 18px 20px;
    border-radius: var(--radius-xl);
    color: var(--blanco);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 18px 36px -18px rgba(28, 26, 22, 0.55);
  }

  .banner > * {
    position: relative;
    z-index: 2;
  }

  .banner.dark {
    color: var(--tinta);
  }

  .banner h1 {
    font-size: clamp(1.6rem, 6vw, 2.3rem);
  }

  .banner p {
    margin: 4px 0 0;
    font-weight: 600;
  }

  .banner__art {
    display: grid;
    place-items: center;
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .banner__art :global(.icon) {
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.18));
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 18px 0 22px;
  }

  .count {
    margin: 0 auto 0 0;
    font-weight: 700;
    color: var(--tinta-2);
  }

  .sort .select {
    min-height: 40px;
    padding-block: 6px;
    border-radius: 999px;
    font-weight: 700;
  }
</style>

<script>
  import { initFilters } from '../../scripts/filter';

  initFilters({
    form: document.querySelector<HTMLFormElement>('[data-filters]')!,
    grid: document.getElementById('results')!,
    count: document.querySelector('[data-results-count]'),
    empty: document.querySelector('[data-results-empty]'),
  });
</script>

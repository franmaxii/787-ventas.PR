---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Mis compras">
  <div class="container orders-page">
    <div class="success" data-success hidden>
      <span class="success__icon"><Icon name="checkCircle" solid size={34} /></span>
      <div>
        <h2>¡Wepa! Compra confirmada</h2>
        <p>Te avisaremos cuando el vendedor despache tu pedido.</p>
      </div>
    </div>

    <h1 class="page-title">Mis compras</h1>
    <ul class="orders" data-orders></ul>

    <div class="empty" data-orders-empty hidden>
      <span class="empty__icon"><Icon name="bag" size={40} /></span>
      <h2>Aún no has comprado nada</h2>
      <p>Cuando compres, verás aquí el estado de tus pedidos.</p>
      <a href={url('/')} class="btn btn--primary">Ir a comprar</a>
    </div>
  </div>
</Layout>

<style is:global>
  .orders-page .success {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 16px;
    padding: 18px;
    border-radius: var(--radius-xl);
    color: var(--blanco);
    background: linear-gradient(160deg, rgba(85, 178, 110, 0.95), rgba(43, 116, 64, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 16px 34px -14px rgba(57, 149, 82, 0.8);
  }

  .orders-page .success__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .orders-page .success h2 {
    font-size: 1.3rem;
  }

  .orders-page .success p {
    margin: 4px 0 0;
    font-weight: 600;
  }

  .orders-page .orders {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .orders-page .order {
    padding: 16px;
    border-radius: var(--radius-xl);
  }

  .orders-page .order.is-new {
    box-shadow: 0 0 0 3px var(--verde), var(--shadow-sm);
  }

  .orders-page .order__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 0.9rem;
    color: var(--tinta-2);
  }

  .orders-page .status {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--amarillo);
    color: var(--tinta);
    font-weight: 800;
    font-size: 0.8rem;
  }

  .orders-page .order__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .orders-page .order__item {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 12px;
    align-items: center;
  }

  .orders-page .order__img {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 14px;
    font-size: 1.6rem;
  }

  .orders-page .order__img img {
    padding: 4px;
  }

  .orders-page .order__item a {
    color: var(--tinta);
    font-weight: 700;
    text-decoration: none;
  }

  .orders-page .order__item small {
    display: block;
    color: var(--tinta-3);
  }

  .orders-page .order__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 2px dashed var(--linea);
    font-size: 0.9rem;
    color: var(--tinta-2);
  }

  .orders-page .order__foot strong {
    color: var(--tinta);
    font-size: 1.1rem;
  }
</style>

<script>
  import { formatMoney } from '../lib/format';
  import { base, url } from '../lib/url';
  import { getProduct } from '../data/products';
  import { orders } from '../scripts/store';
  import { esc, formatDate } from '../scripts/ui';

  const list = document.querySelector<HTMLUListElement>('[data-orders]')!;
  const empty = document.querySelector<HTMLElement>('[data-orders-empty]')!;
  const newId = new URLSearchParams(window.location.search).get('nueva');
  const all = orders.all();

  document.querySelector<HTMLElement>('[data-success]')!.hidden = !newId || !all.some((o) => o.id === newId);
  empty.hidden = all.length > 0;

  list.innerHTML = all
    .map(
      (o) => `
    <li class="order glass-lite ${o.id === newId ? 'is-new' : ''}">
      <div class="order__head">
        <span>${formatDate(o.date)} · Pedido #${esc(o.id)}</span>
        <span class="status">${o.delivery === 'recogido' ? 'Listo para coordinar' : 'Preparando envío'}</span>
      </div>
      <ul class="order__items">
        ${o.lines
          .map(
            (l) => `
          <li class="order__item">
            <span class="order__img tile tile--${esc(l.color)}" aria-hidden="true">${
              (l.image ?? getProduct(l.id)?.image) ? `<img src="${esc(url(l.image ?? getProduct(l.id)!.image!))}" alt="" />` : esc(l.emoji)
            }</span>
            <span>
              <a href="${base}/producto/${esc(l.id)}">${esc(l.title)}</a>
              <small>${l.qty} × ${formatMoney(l.price)}</small>
            </span>
            <strong>${formatMoney(l.price * l.qty)}</strong>
          </li>`,
          )
          .join('')}
      </ul>
      <div class="order__foot">
        <span>${o.delivery === 'recogido' ? 'Recogido' : `Envío a ${esc(o.town)}`} · ${esc(o.payment)}</span>
        <span>Total <strong>${formatMoney(o.total)}</strong></span>
      </div>
    </li>`,
    )
    .join('');
</script>

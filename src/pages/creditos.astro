---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import { products } from '../data/products';
import { licenseLabel, photoCredits, sourceLabel } from '../data/fotos';

const rows = products
  .filter((p) => photoCredits[p.id] && p.image)
  .map((p) => ({ p, c: photoCredits[p.id] }))
  .sort((a, b) => a.p.title.localeCompare(b.p.title, 'es'));
---

<Layout title="Créditos de fotos" description="Fotógrafos y licencias de las fotos de las publicaciones de ejemplo de Plaza 787.">
  <div class="container credits">
    <h1 class="page-title">Créditos de fotos</h1>
    <p class="lead">
      Las publicaciones de este prototipo son de ejemplo. Sus fotos son de personas que las compartieron con licencias libres
      en sitios como Flickr y Wikimedia Commons; las encontramos con <a href="https://openverse.org">Openverse</a>. Todas permiten uso
      comercial y cambios: las recortamos en cuadrado y las redujimos de tamaño. Gracias a cada fotógrafo.
    </p>

    <ul class="list">
      {
        rows.map(({ p, c }) => (
          <li class="panel row">
            <a href={url(`/producto/${p.id}`)} class="row__img">
              <img src={url(p.image!)} alt="" width="72" height="72" loading="lazy" />
            </a>
            <div class="row__text">
              <a href={url(`/producto/${p.id}`)} class="row__product">{p.title}</a>
              <span>
                “<a href={c.url}>{c.title}</a>” de {c.creatorUrl ? <a href={c.creatorUrl}>{c.creator}</a> : c.creator}
              </span>
              <span class="row__meta">
                {sourceLabel(c)} · {c.licenseUrl ? <a href={c.licenseUrl}>{licenseLabel(c)}</a> : licenseLabel(c)}
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="note">
      ¿Una de estas fotos es tuya y quieres que la quitemos o cambiemos el crédito? <a href={url('/contacto')}>Escríbenos</a>.
    </p>
  </div>
</Layout>

<style>
  .credits {
    max-width: 820px;
    display: grid;
    gap: 16px;
    padding-bottom: 24px;
  }

  .credits > .page-title {
    margin-bottom: 0;
  }

  .lead,
  .note {
    margin: 0;
    line-height: 1.5;
    color: var(--tinta-2);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .row {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
  }

  .row__img {
    flex: none;
  }

  .row__img img {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 14px;
    object-fit: cover;
  }

  .row__text {
    display: grid;
    gap: 2px;
    min-width: 0;
    font-size: 0.88rem;
    line-height: 1.35;
    color: var(--tinta-2);
    overflow-wrap: anywhere;
  }

  .row__product {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tinta);
    text-decoration: none;
  }

  .row__meta {
    color: var(--tinta-3);
  }
</style>

---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import SearchBar from '../components/SearchBar.astro';
import LocationChip from '../components/LocationChip.astro';
import CategoryRow from '../components/CategoryRow.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Icon from '../components/Icon.astro';
import { activeProducts as products } from '../data/products';
import { getCategory } from '../data/categories';
import AdBanner from '../components/AdBanner.astro';
import { adFor, getAd } from '../data/ads';

// "Selecciones de hoy": todo lo activo; el navegador lo ordena por cercanía.
const picks = [...products].sort((a, b) => Number(!!b.featured) - Number(!!a.featured) || a.daysAgo - b.daysAgo);
const drops = products.filter((p) => p.originalPrice && p.originalPrice > p.price);
const local = products.filter((p) => p.local);

// Carriles por categoría (en el orden en que salen en la portada)
const lane = (slug: string) => {
  const c = getCategory(slug)!;
  return { slug, name: c.name, icon: c.icon, color: c.color, items: products.filter((p) => p.category === slug) };
};
const lanesTop = ['vehiculos', 'alquileres', 'venta-bienes-raices'].map(lane);
const lanesBottom = ['donaciones', 'renta-articulos'].map(lane);
---

<Layout>
  <HeroVideo />
  <SearchBar />
  <LocationChip />
  <CategoryRow />

  <div class="container">
    <section class="section">
      <div class="section__head">
        <h2 class="section__title">Selecciones de hoy</h2>
        <a class="section__link" href={url('/buscar?orden=cerca')}>Cerca de ti</a>
      </div>
      <p class="sub">Ordenadas por cercanía a <span data-location-label>tu pueblo</span>.</p>
      <ProductGrid products={picks.slice(0, 12)} filterable id="picks" ad={adFor()} adSlot={4} />
    </section>

    {
      lanesTop.map((l) => (
        <section class="section">
          <div class="section__head">
            <h2 class="section__title lane-title">
              <span class={`lane-title__icon lane-title__icon--${l.color}`} aria-hidden="true">
                <Icon name={l.icon} size={22} stroke={1.8} />
              </span>
              {l.name}
            </h2>
            <a class="section__link" href={url(`/categoria/${l.slug}`)}>Ver todo</a>
          </div>
          <ProductGrid products={l.items} scroller />
        </section>
      ))
    }

    <section class="sell-cta">
      <div>
        <h2>¿Tienes algo que vender?</h2>
        <p>Publica gratis en un minuto. Los interesados te escriben y se encuentran en tu pueblo.</p>
      </div>
      <a href={url('/vender')} class="btn btn--white">
        <Icon name="camera" size={20} /> Vender ahora
      </a>
    </section>

    {
      lanesBottom.map((l) => (
        <section class="section">
          <div class="section__head">
            <h2 class="section__title lane-title">
              <span class={`lane-title__icon lane-title__icon--${l.color}`} aria-hidden="true">
                <Icon name={l.icon} size={22} stroke={1.8} />
              </span>
              {l.name}
            </h2>
            <a class="section__link" href={url(`/categoria/${l.slug}`)}>Ver todo</a>
          </div>
          <ProductGrid products={l.items} scroller />
        </section>
      ))
    }

    <AdBanner ad={getAd('mudanzas')} />

    <section class="section">
      <div class="section__head">
        <h2 class="section__title">Bajaron de precio</h2>
        <a class="section__link" href={url('/buscar?baja=1')}>Ver todo</a>
      </div>
      <ProductGrid products={drops} scroller />
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="section__title">Hecho en Puerto Rico</h2>
      </div>
      <ProductGrid products={local} />
    </section>

    <ul class="trust">
      <li>
        <span class="trust__icon"><Icon name="verified" /></span>
        <strong>Perfiles verificados</strong>
        <span>Quien vende confirmó su identidad.</span>
      </li>
      <li>
        <span class="trust__icon"><Icon name="chat" /></span>
        <strong>Todo por Mensajes</strong>
        <span>No tienes que dar tu número para coordinar.</span>
      </li>
      <li>
        <span class="trust__icon"><Icon name="pin" /></span>
        <strong>Encuentro seguro</strong>
        <span>Lugar público, de día, y pagas al recibir.</span>
      </li>
    </ul>
  </div>
</Layout>

<style>
  .lane-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lane-title__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--glass-bg-strong);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-edge), var(--shadow-sm);
  }

  .lane-title__icon--azul { color: var(--azul-700); }
  .lane-title__icon--rojito { color: var(--rojito-700); }
  .lane-title__icon--amarillo { color: var(--amarillo-700); }
  .lane-title__icon--verde { color: var(--verde-700); }

  .sub {
    margin: -8px 0 14px;
    color: var(--tinta-3);
    font-size: 0.9rem;
  }

  .sell-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-block: 36px;
    padding: 22px;
    border-radius: var(--radius-lg);
    background: var(--amarillo);
    box-shadow: var(--shadow-sm);
  }

  .sell-cta h2 {
    font-size: 1.4rem;
  }

  .sell-cta p {
    margin: 4px 0 0;
    font-weight: 600;
  }

  .trust {
    list-style: none;
    margin: 40px 0 20px;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  @media (min-width: 720px) {
    .trust {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .trust li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    align-items: center;
    padding: 16px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.6);
  }

  .trust__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--verde);
    color: var(--blanco);
  }

  .trust span:last-child {
    font-size: 0.9rem;
    color: var(--tinta-2);
  }
</style>

<script>
  import { milesBetween } from '../data/pueblos';
  import { location, onChange } from '../scripts/store';
  import { placeAd } from '../scripts/ads';

  // Ordena "Selecciones de hoy" por cercanía al pueblo elegido.
  const grid = document.getElementById('picks');
  function sortByDistance() {
    if (!grid) return;
    const town = location.get().town;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-id]'));
    cards
      .map((c) => ({ c, d: milesBetween(town, c.dataset.town ?? '') }))
      .sort((a, b) => a.d - b.d)
      .forEach(({ c }) => grid.appendChild(c));
    placeAd(grid);
  }
  sortByDistance();
  onChange(sortByDistance);
</script>

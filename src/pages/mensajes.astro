---
import { url } from '../lib/url';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mensajes">
  <div class="container msgs-page">
    <h1 class="page-title">Mensajes</h1>
    <p class="page-sub">Tus preguntas a los vendedores.</p>

    <ul class="msgs" data-msgs></ul>

    <div class="empty" data-msgs-empty hidden>
      <span class="empty__icon"><Icon name="chat" size={40} /></span>
      <h2>No tienes mensajes</h2>
      <p>Pregúntale al vendedor desde la página de cualquier producto.</p>
      <a href={url('/')} class="btn btn--primary">Ver productos</a>
    </div>
  </div>
</Layout>

<style is:global>
  .msgs-page .msgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .msgs-page .msg {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: start;
    padding: 14px;
    border-radius: var(--radius-xl);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-edge), var(--glass-shadow);
    color: var(--tinta);
    text-decoration: none;
  }

  .msgs-page .msg__avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--azul);
    color: var(--blanco);
    font-size: 1.4rem;
  }

  .msgs-page .msg__title {
    display: block;
    font-weight: 800;
  }

  .msgs-page .msg__text {
    display: block;
    margin: 4px 0;
  }

  .msgs-page .msg small {
    color: var(--tinta-3);
  }
</style>

<script>
  import { questions } from '../scripts/store';
  import { base } from '../lib/url';
  import { esc, formatDate } from '../scripts/ui';

  const all = questions.all();
  document.querySelector<HTMLElement>('[data-msgs-empty]')!.hidden = all.length > 0;
  document.querySelector<HTMLUListElement>('[data-msgs]')!.innerHTML = all
    .map(
      (q) => `
    <li>
      <a class="msg" href="${base}/producto/${esc(q.productId)}#preguntas">
        <span class="msg__avatar" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg></span>
        <span>
          <span class="msg__title">${esc(q.productTitle)}</span>
          <span class="msg__text">${esc(q.text)}</span>
          <small>${formatDate(q.date)} · Esperando respuesta</small>
        </span>
      </a>
    </li>`,
    )
    .join('');
</script>

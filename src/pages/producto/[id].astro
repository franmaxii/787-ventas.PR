---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { activeProducts, getSeller, products, statusOf, townOf, type Product } from '../../data/products';
import { getCategory } from '../../data/categories';
import { licenseLabel, photoCredit, sourceLabel } from '../../data/fotos';
import AdBanner from '../../components/AdBanner.astro';
import { smallSrc } from '../../lib/img';
import { adFor } from '../../data/ads';
import { formatMiles, formatMoney, priceLabel, timeAgo } from '../../lib/format';

export function getStaticPaths() {
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const seller = getSeller(p.sellerId)!;
const category = getCategory(p.category);
const credit = photoCredit(p.id);
const town = townOf(p);
const status = statusOf(p);
const isActive = status === 'activo';
const dropped = !!p.originalPrice && p.originalPrice > p.price;
const fromSeller = activeProducts.filter((x) => x.sellerId === p.sellerId && x.id !== p.id).slice(0, 4);
const similar = activeProducts
  .filter((x) => x.category === p.category && x.id !== p.id && x.sellerId !== p.sellerId)
  .slice(0, 4);

const isProperty = p.type === 'alquiler' || p.type === 'propiedad';
const isRent = p.category === 'renta-articulos';
const facts: [string, string][] = [
  ...(isProperty ? [] : ([['Condición', p.condition === 'nuevo' ? 'Nuevo' : 'Usado']] as [string, string][])),
  ['Categoría', category?.name ?? ''],
];
if (isRent) facts.push(['Precio', 'Por día']);
if (p.vehicle) {
  facts.push(
    ['Año', String(p.vehicle.year)],
    ['Marca y modelo', `${p.vehicle.make} ${p.vehicle.model}`],
    ['Millaje', `${formatMiles(p.vehicle.miles)} millas`],
    ['Transmisión', p.vehicle.transmission],
  );
}
if (p.rental) {
  facts.push(
    ['Cuartos', String(p.rental.beds)],
    ['Baños', String(p.rental.baths)],
  );
  if (p.type === 'alquiler') facts.push(['Amueblado', p.rental.furnished ? 'Sí' : 'No']);
}
const quick =
  p.type === 'alquiler'
    ? ['¿Sigue disponible?', '¿Cuándo la puedo ver?', '¿Qué incluye la renta?', '¿Aceptan mascotas?']
    : p.type === 'propiedad'
      ? ['¿Sigue disponible?', '¿Cuándo la puedo ver?', '¿Acepta FHA?', '¿Cuánto es el CRIM?']
      : isRent
        ? ['¿Está disponible el sábado?', '¿Cuánto es el depósito?', '¿Incluye entrega?', '¿Cuál es el último precio?']
        : ['¿Sigue disponible?', '¿Cuál es el último precio?', '¿Dónde nos podemos encontrar?', '¿Lo puedo recoger hoy?'];
---

<Layout title={p.title} description={`${priceLabel(p)} · ${town}. ${p.description}`}>
  <div class="container">
    <nav class="crumbs" aria-label="Ruta">
      <a href={url('/')}>Inicio</a>
      <Icon name="chevronRight" size={14} />
      {category && <a href={url(`/categoria/${category.slug}`)}>{category.name}</a>}
    </nav>

    <div class="pdp">
      <div class="pdp__media">
        <ProductImage product={p} size="large" loading="eager" />
        <button type="button" class="pdp__fav" hidden={!isActive} data-fav={p.id} aria-pressed="false" aria-label={`Añadir ${p.title} a favoritos`}>
          <Icon name="heart" size={24} stroke={2} />
        </button>
        {
          credit && (
            <p class="pdp__credit">
              Foto de ejemplo:{' '}
              {credit.creatorUrl ? <a href={credit.creatorUrl}>{credit.creator}</a> : credit.creator} ·{' '}
              <a href={credit.url}>{sourceLabel(credit)}</a> ·{' '}
              {credit.licenseUrl ? <a href={credit.licenseUrl}>{licenseLabel(credit)}</a> : licenseLabel(credit)}
            </p>
          )
        }
      </div>

      <div class="pdp__info">
        <h1 class="pdp__title">{p.title}</h1>
        <p class="pdp__price">
          <strong>{priceLabel(p)}</strong>
          {dropped && <s>{formatMoney(p.originalPrice!)}</s>}
          {dropped && <span class="pill-drop">Bajó de precio</span>}
        </p>
        <p class="pdp__meta">
          <Icon name="pin" solid size={16} />
          <span data-dist={town}>{town}</span>
          <span aria-hidden="true">·</span>
          <span>Publicado {timeAgo(p.daysAgo).toLowerCase()}</span>
        </p>

        {
          !isActive && (
            <div class="ended panel">
              <Icon name="archive" size={26} />
              <div>
                <strong>{status === 'vendido' ? 'Este artículo ya se vendió' : 'Esta publicación expiró'}</strong>
                <p>Mira otras publicaciones de {seller.username}.</p>
              </div>
            </div>
          )
        }

        <form
          class="msgbox panel"
          data-msg-form
          hidden={!isActive}
          data-listing={p.id}
          data-title={p.title}
          data-price={p.price}
          data-type={p.type ?? 'articulo'}
          data-category={p.category}
          data-image={p.image ? url(smallSrc(p.image)) : ''}
          data-color={p.color}
          data-seller-name={seller.username}
          data-seller-id={seller.id}
        >
          <h2><Icon name="chat" solid size={22} /> Envíale un mensaje al vendedor</h2>
          <div class="quick" role="group" aria-label="Mensajes rápidos">
            {quick.map((q) => <button type="button" class="chip" data-quick={q}>{q}</button>)}
          </div>
          <div class="msgbox__row">
            <label for="msg" class="sr-only">Mensaje</label>
            <input id="msg" name="text" class="input" value="Hola, ¿sigue disponible?" maxlength="500" required />
            <button type="submit" class="btn btn--primary">Enviar</button>
          </div>
          <p class="hint">Responde {seller.responds}. Nunca compartas códigos ni pagues por adelantado.</p>
        </form>

        <div class="actions" hidden={!isActive}>
          <button type="button" class="act" data-fav={p.id} aria-pressed="false"><Icon name="heart" size={20} /> Favorito</button>
          <button type="button" class="act" data-collect={p.id} aria-haspopup="dialog"><Icon name="folderPlus" size={20} /> Colección</button>
          <button type="button" class="act" data-offer><Icon name="currency" size={20} /> Hacer oferta</button>
          <button type="button" class="act" data-share><Icon name="share" size={20} /> Compartir</button>
          <button type="button" class="act" data-report><Icon name="flag" size={20} /> Reportar</button>
        </div>

        <section class="panel details">
          <h2>Detalles</h2>
          <dl class="facts">
            {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <p class="desc">{p.description}</p>
          <ul class="specs">
            {p.details.map((d) => <li><Icon name="check" size={16} /> {d}</li>)}
          </ul>
          {
            p.type === 'vehiculo' && (
              <p class="tip"><Icon name="id" size={18} /> El traspaso se hace en CESCO. Pide ver el título y la licencia del vendedor antes de pagar.</p>
            )
          }
          {
            p.type === 'alquiler' && (
              <p class="tip"><Icon name="shieldAlert" size={18} /> Nunca pagues depósito ni renta sin ver la propiedad en persona y firmar un contrato.</p>
            )
          }
          {
            p.type === 'propiedad' && (
              <p class="tip"><Icon name="document" size={18} /> Antes de dar dinero, verifica la titularidad en el Registro de la Propiedad y cierra la compraventa ante notario. Nunca envíes depósitos sin ver la propiedad.</p>
            )
          }
          {
            isRent && (
              <p class="tip"><Icon name="calendar" size={18} /> Acuerden por escrito las fechas, el depósito y el estado del artículo al entregarlo y al devolverlo.</p>
            )
          }
        </section>

        <a href={url(`/vendedor/${seller.id}`)} class="seller panel">
          <span class="seller__avatar" aria-hidden="true"><Icon name="user" solid size={40} /></span>
          <span class="seller__body">
            <span class="seller__name">
              {seller.username}
              {seller.star && <Icon name="verified" solid size={18} label="Identidad verificada" class="seller__check" />}
            </span>
            <span class="seller__meta">
              <Icon name="home" solid size={14} />
              {seller.town} · en Plaza 787 desde {seller.since}
            </span>
            <span class="seller__rating">
              <Stars rating={seller.rating} size={14} tone="naranja" />
              {seller.rating.toFixed(1)} · responde {seller.responds}
            </span>
          </span>
          <span class="seller__cta">Ver perfil <Icon name="chevronRight" size={16} /></span>
        </a>

        <section class="panel safety">
          <h2><Icon name="shield" size={22} /> Para un encuentro seguro</h2>
          <ul>
            <li><Icon name="pin" size={18} /> Encuéntrense en un lugar público y con cámaras: un centro comercial o frente a un cuartel de la Policía.</li>
            <li><Icon name="users" size={18} /> Ve de día y, si puedes, acompañado.</li>
            <li><Icon name="eye" size={18} /> Revisa el artículo antes de pagar.</li>
            <li><Icon name="cash" size={18} /> Paga al recibir: en efectivo o por ATH Móvil en persona.</li>
            <li><Icon name="shieldAlert" size={18} /> Nunca envíes depósitos, códigos de verificación ni pagos por adelantado.</li>
          </ul>
        </section>
      </div>
    </div>

    <AdBanner ad={adFor(p.category)} />

    {
      fromSeller.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2 class="section__title">Más de {seller.username}</h2>
            <a class="section__link" href={url(`/vendedor/${seller.id}`)}>Ver todo</a>
          </div>
          <ProductGrid products={fromSeller} />
        </section>
      )
    }
    {
      similar.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2 class="section__title">Publicaciones similares</h2>
          </div>
          <ProductGrid products={similar} />
        </section>
      )
    }
  </div>

  <dialog class="sheet" data-offer-dialog aria-labelledby="offer-title">
    <form method="dialog" data-offer-form>
      <h2 id="offer-title">Hacer una oferta</h2>
      <p class="hint">Precio publicado: {priceLabel(p)}. El vendedor recibirá tu oferta por mensaje.</p>
      <div class="field">
        <label for="offer">Tu oferta (USD)</label>
        <input id="offer" name="amount" class="input" type="number" min="1" step="1" inputmode="numeric" required />
      </div>
      <div class="sheet__actions">
        <button type="button" class="btn btn--soft" data-close>Cancelar</button>
        <button type="submit" class="btn btn--primary" value="send">Enviar oferta</button>
      </div>
    </form>
  </dialog>

  <dialog class="sheet" data-report-dialog aria-labelledby="report-title">
    <form method="dialog" data-report-form>
      <h2 id="report-title">Reportar publicación</h2>
      <p class="hint">Nuestro equipo la revisará. El vendedor no sabrá quién la reportó.</p>
      <div class="reasons">
        {
          ['Estafa o fraude', 'Artículo prohibido', 'Información o fotos falsas', 'Precio abusivo en emergencia', 'Otro'].map((r, i) => (
            <label class="chip chip--toggle">
              <input type="radio" name="reason" value={r} checked={i === 0} /> {r}
            </label>
          ))
        }
      </div>
      <div class="sheet__actions">
        <button type="button" class="btn btn--soft" data-close>Cancelar</button>
        <button type="submit" class="btn btn--red" value="send">Enviar reporte</button>
      </div>
    </form>
  </dialog>
</Layout>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block: 14px 10px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .crumbs a {
    text-decoration: none;
  }

  .pdp {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 860px) {
    .pdp {
      grid-template-columns: 1.1fr 1fr;
      gap: 32px;
      align-items: start;
    }

    .pdp__media {
      position: sticky;
      top: 90px;
    }
  }

  .pdp__media {
    position: relative;
  }

  .pdp__credit {
    margin: 8px 6px 0;
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--tinta-3);
    overflow-wrap: anywhere;
  }

  .pdp__credit a {
    color: inherit;
  }

  /* los hijos de un grid no se encogen solos: sin esto la fila de mensajes rápidos ensancha la página */
  .pdp > *,
  .pdp__info > * {
    min-width: 0;
  }

  .pdp__fav {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    color: var(--azul-700);
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.35);
  }

  .pdp__fav[aria-pressed='true'] :global(.icon),
  .act[aria-pressed='true'] :global(.icon) {
    fill: currentColor;
  }

  .pdp__info {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .pdp__title {
    font-size: clamp(1.5rem, 5.5vw, 2.1rem);
  }

  .pdp__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: -4px 0 0;
  }

  .pdp__price strong {
    font-size: clamp(1.9rem, 8vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .pdp__price s {
    color: var(--tinta-3);
  }

  .pill-drop {
    padding: 3px 10px;
    border-radius: 999px;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    background: linear-gradient(180deg, #ff6c61, var(--rojito));
  }

  .pdp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: -6px 0 0;
    color: var(--tinta-2);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .pdp__meta :global(.icon) {
    color: var(--rojito);
  }

  .msgbox h2,
  .details h2,
  .safety h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.15rem;
    margin-bottom: 12px;
  }

  .msgbox h2 :global(.icon) {
    color: var(--azul);
  }

  .quick {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: none;
  }

  .msgbox__row {
    display: flex;
    gap: 8px;
  }

  .msgbox__row .btn {
    flex: none;
  }

  .msgbox .hint {
    margin-top: 10px;
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }

  .act {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 10px 4px;
    border-radius: 18px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-edge), var(--shadow-sm);
    color: var(--tinta);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .act :global(.icon) {
    color: var(--azul-700);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 0 0 14px;
  }

  .facts div {
    padding: 10px 12px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.55);
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }

  .facts dd {
    margin: 2px 0 0;
    font-weight: 700;
  }

  .desc {
    margin: 0 0 12px;
    font-size: 1.02rem;
  }

  .specs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .specs li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .specs :global(.icon) {
    color: var(--verde);
  }

  .tip {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin: 14px 0 0;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 0.9rem;
    color: var(--azul-700);
    background: rgba(13, 144, 171, 0.1);
  }

  .tip :global(.icon) {
    flex: none;
  }

  .seller {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--tinta);
    text-decoration: none;
    transition: transform 0.25s var(--ease-spring);
  }

  .seller:hover {
    transform: translateY(-2px);
  }

  .seller__avatar {
    display: grid;
    place-items: end center;
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
    color: var(--rojito);
    background: var(--blanco);
    box-shadow: 0 6px 16px -6px rgba(74, 56, 22, 0.45);
  }

  .seller__body {
    display: grid;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .seller__name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 800;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }

  .seller__name :global(.seller__check) {
    color: var(--azul);
    flex: none;
  }

  .seller__meta,
  .seller__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--tinta-2);
    font-size: 0.82rem;
  }

  .seller__meta :global(.icon) {
    color: var(--rojito);
  }

  .seller__cta {
    display: inline-flex;
    align-items: center;
    flex: none;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--azul-700);
  }

  .safety ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.92rem;
  }

  .safety li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .safety li :global(.icon) {
    flex: none;
    color: var(--verde);
    margin-top: 1px;
  }

  .ended {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--rojito-700);
  }

  .ended strong {
    color: var(--tinta);
  }

  .ended p {
    margin: 2px 0 0;
    color: var(--tinta-2);
    font-size: 0.9rem;
  }

  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
</style>

<script>
  import { url } from '../../lib/url';
  import { chats } from '../../scripts/store';
  import { toast } from '../../scripts/ui';

  const form = document.querySelector<HTMLFormElement>('[data-msg-form]')!;
  const input = form.querySelector<HTMLInputElement>('input[name="text"]')!;
  const d = form.dataset;

  /** Abre (o crea) la conversación con el vendedor y envía el mensaje. */
  function sendToSeller(text: string) {
    const conv = chats.ensure({
      id: d.listing!,
      listingId: d.listing!,
      role: 'comprando',
      title: d.title!,
      price: Number(d.price),
      type: d.type,
      category: d.category,
      image: d.image || undefined,
      color: d.color!,
      withName: d.sellerName!,
      withId: d.sellerId,
    });
    if (!chats.send(conv.id, text)) return toast('No se pudo guardar el mensaje en este navegador');
    window.location.href = url(`/mensajes?c=${encodeURIComponent(conv.id)}`);
  }

  form.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.quick!;
      input.focus();
    }),
  );

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (text) sendToSeller(text);
  });

  // ---------- Oferta ----------
  const offerDialog = document.querySelector<HTMLDialogElement>('[data-offer-dialog]')!;
  const offerForm = document.querySelector<HTMLFormElement>('[data-offer-form]')!;
  document.querySelector('[data-offer]')?.addEventListener('click', () => offerDialog.showModal());
  offerForm.addEventListener('submit', () => {
    const amount = Number(new FormData(offerForm).get('amount'));
    if (amount > 0) sendToSeller(`Hola, ¿aceptarías $${amount.toLocaleString('es-PR')} por ${d.title}?`);
  });

  // ---------- Compartir ----------
  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    const shareUrl = window.location.href;
    try {
      if (navigator.share) await navigator.share({ title: d.title, url: shareUrl });
      else {
        await navigator.clipboard.writeText(shareUrl);
        toast('Enlace copiado');
      }
    } catch {
      /* el usuario canceló */
    }
  });

  // ---------- Reportar ----------
  const reportDialog = document.querySelector<HTMLDialogElement>('[data-report-dialog]')!;
  document.querySelector('[data-report]')?.addEventListener('click', () => reportDialog.showModal());
  document.querySelector('[data-report-form]')!.addEventListener('submit', () => {
    toast('Gracias. Revisaremos esta publicación.');
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.sheet').forEach((dlg) => {
    dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>
